# Copy to .env and fill in. Never commit .env.

# Copernicus Data Space OAuth client (optional; without it the first run asks
# for a browser login). Create at https://shapps.dataspace.copernicus.eu/dashboard/
# under User Settings > OAuth clients.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Groq API key for the situation-report copilot.
GROQ_API_KEY=
